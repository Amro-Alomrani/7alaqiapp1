# AI provider credentials must be stored in Firebase Functions Secret Manager.
# Never place provider API keys in VITE_* variables or the mobile app bundle.

# Firebase Web app config. Fill these from the Firebase project used by the app.
# Keep the project ID the same as the project where barber profiles are stored.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Supabase Storage only. Firebase Auth, Firestore, Functions and FCM remain active.
VITE_SUPABASE_URL=https://vjeuesqrzywragnjvkpi.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PUBLIC_MEDIA_BUCKET=halaqi-media
VITE_SUPABASE_PRIVATE_CHAT_BUCKET=halaqi-chat

# Optional: restore the previous CARTO Voyager basemap. CARTO requires an app-owned key.
# If empty or unavailable, maps use OpenStreetMap tiles instead.
VITE_CARTO_API_KEY=
