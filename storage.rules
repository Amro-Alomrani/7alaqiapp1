rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null
        && !firestore.exists(/databases/(default)/documents/accountDeletionLocks/$(request.auth.uid));
    }

    function isImageUpload() {
      return request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /users/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.auth.uid == userId && isImageUpload();
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /barbers/{barberId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.auth.uid == barberId && isImageUpload();
      allow delete: if signedIn() && request.auth.uid == barberId;
    }

    match /posts/{userId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.auth.uid == userId && isImageUpload();
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /chats/{bookingId}/{fileName} {
      function isBookingParticipant() {
        let booking = firestore.get(/databases/(default)/documents/bookings/$(bookingId)).data;
        return signedIn()
          && (booking.customerUid == request.auth.uid || booking.barberId == request.auth.uid);
      }
      allow read: if isBookingParticipant();
      // New chat images use Supabase; closing legacy uploads prevents a
      // participant from recreating files after account-deletion cleanup.
      allow create, update: if false;
      allow delete: if isBookingParticipant()
        && fileName.matches('^' + request.auth.uid + '-.*$');
    }
  }
}
