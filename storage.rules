rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isImageUpload() {
      return request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /users/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == userId && isImageUpload();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /barbers/{barberId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == barberId && isImageUpload();
      allow delete: if request.auth != null && request.auth.uid == barberId;
    }

    match /posts/{userId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == userId && isImageUpload();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /chats/{bookingId}/{fileName} {
      function isBookingParticipant() {
        let booking = firestore.get(/databases/(default)/documents/bookings/$(bookingId)).data;
        return request.auth != null
          && (booking.customerUid == request.auth.uid || booking.barberId == request.auth.uid);
      }
      allow read: if isBookingParticipant();
      allow create: if isBookingParticipant() && isImageUpload();
      allow update: if false;
      allow delete: if isBookingParticipant()
        && fileName.matches('^' + request.auth.uid + '-.*$');
    }
  }
}
