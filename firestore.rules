rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function notDeleting(uid) {
      return uid is string
        && !exists(/databases/$(database)/documents/accountDeletionLocks/$(uid));
    }

    function signedIn() {
      return request.auth != null && notDeleting(request.auth.uid);
    }

    function bookingParticipant(bookingId) {
      let booking = get(/databases/$(database)/documents/bookings/$(bookingId)).data;
      return signedIn()
        && !exists(/databases/$(database)/documents/accountDeletionBookingLocks/$(bookingId))
        && notDeleting(booking.customerUid) && notDeleting(booking.barberId)
        && (booking.customerUid == request.auth.uid || booking.barberId == request.auth.uid);
    }

    function bookingParticipantAfter(bookingId) {
      let booking = getAfter(/databases/$(database)/documents/bookings/$(bookingId)).data;
      return signedIn()
        && !exists(/databases/$(database)/documents/accountDeletionBookingLocks/$(bookingId))
        && notDeleting(booking.customerUid) && notDeleting(booking.barberId)
        && request.auth.uid in [booking.customerUid, booking.barberId];
    }

    match /barbers/{barberId} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == barberId
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn()
        && (request.auth.uid == barberId || resource.data.ownerUid == request.auth.uid)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'shopName', 'avatar', 'coverImage', 'distance', 'eta', 'services',
          'specialties', 'queueCount', 'available', 'featured', 'address', 'description',
          'avgDuration', 'liveStatus', 'gallery', 'updatedAt', 'totalChairs', 'isOnboarded',
          'staffIds', 'workingHours', 'lat', 'lng', 'isLive', 'onboardingComplete',
          'fcmToken', 'liveLocation', 'liveLocationUpdatedAt', 'trustScore', 'offersHomeService', 'homeServiceFee'
        ])
        && request.resource.data.get('offersHomeService', false) is bool
        && request.resource.data.get('homeServiceFee', 0) is number
        && request.resource.data.get('homeServiceFee', 0) >= 0;
      allow delete: if false;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid
        && !exists(/databases/$(database)/documents/accountDeletionPostLocks/$(postId))
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'postedBy', 'barber', 'type', 'image', 'beforeImage', 'afterImage',
          'hairStyle', 'tags', 'likes', 'comments', 'saves', 'location', 'caption',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.postedBy in ['barber', 'customer'];
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'image', 'beforeImage', 'afterImage', 'hairStyle', 'tags', 'location', 'caption', 'updatedAt'
        ]);
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /bookings/{bookingId} {
      allow read: if signedIn() && (resource.data.customerUid == request.auth.uid || resource.data.barberId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.customerUid == request.auth.uid
        && !exists(/databases/$(database)/documents/accountDeletionBookingLocks/$(bookingId))
        && request.resource.data.status == 'requested'
        && request.resource.data.barberId is string
        && notDeleting(request.resource.data.barberId)
        && exists(/databases/$(database)/documents/barbers/$(request.resource.data.barberId))
        && get(/databases/$(database)/documents/barbers/$(request.resource.data.barberId)).data.isLive == true
        && get(/databases/$(database)/documents/barbers/$(request.resource.data.barberId)).data.services.hasAny([request.resource.data['service']])
        && request.resource.data.keys().hasOnly([
          'customerUid', 'customerName', 'customerPhone', 'customerAvatar', 'barberId',
          'barberName', 'barberShop', 'barberAvatar', 'staffId', 'staffName', 'staffAvatar',
          'service', 'date', 'time', 'status', 'totalPrice', 'tip', 'payMethod', 'pointsEarned',
          'notes', 'customerLocation', 'customerLocationUpdatedAt', 'homeServiceFee', 'homeService', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.totalPrice is number
        && request.resource.data['service']['price'] is number
        && request.resource.data.get('tip', 0) is number
        && request.resource.data.get('tip', 0) >= 0
        && request.resource.data.get('homeServiceFee', 0) is number
        && request.resource.data.get('homeServiceFee', 0) >= 0
        && request.resource.data.get('homeService', false) is bool
        && ((request.resource.data.get('homeService', false) == true
            && get(/databases/$(database)/documents/barbers/$(request.resource.data.barberId)).data.get('offersHomeService', false) == true
            && request.resource.data.get('homeServiceFee', 0) == get(/databases/$(database)/documents/barbers/$(request.resource.data.barberId)).data.get('homeServiceFee', 0))
          || (request.resource.data.get('homeService', false) == false
            && request.resource.data.get('homeServiceFee', 0) == 0))
        && request.resource.data.totalPrice == request.resource.data['service']['price'] + request.resource.data.get('tip', 0) + request.resource.data.get('homeServiceFee', 0)
        && request.resource.data.pointsEarned == 0
        && request.resource.data.payMethod in ['cash'];
      allow update: if signedIn()
        && !exists(/databases/$(database)/documents/accountDeletionBookingLocks/$(bookingId))
        && notDeleting(resource.data.customerUid) && notDeleting(resource.data.barberId)
        && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.updatedAt is number
          && ((request.auth.uid == resource.data.customerUid
              && request.resource.data.status == 'cancelled'
              && resource.data.status in ['requested', 'confirmed'])
            || (request.auth.uid == resource.data.barberId
              && ((resource.data.status == 'requested' && request.resource.data.status in ['confirmed', 'rejected', 'cancelled'])
                || (resource.data.status == 'confirmed' && request.resource.data.status in ['in_progress', 'cancelled'])
                || (resource.data.status == 'in_progress' && request.resource.data.status == 'completed')))))
        || (request.auth.uid == resource.data.customerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'customerLocation', 'customerLocationUpdatedAt', 'updatedAt'
          ])
          && request.resource.data.customerLocation.lat is number
          && request.resource.data.customerLocation.lng is number
          && request.resource.data.customerLocation.lat >= -90
          && request.resource.data.customerLocation.lat <= 90
          && request.resource.data.customerLocation.lng >= -180
          && request.resource.data.customerLocation.lng <= 180)
      );
      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.barberId is string
        && notDeleting(request.resource.data.barberId)
        && exists(/databases/$(database)/documents/barbers/$(request.resource.data.barberId))
        && request.resource.data.bookingId == reviewId
        && !exists(/databases/$(database)/documents/accountDeletionBookingLocks/$(request.resource.data.bookingId))
        && exists(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId))
        && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.customerUid == request.auth.uid
        && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.barberId == request.resource.data.barberId
        && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.status == 'completed'
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.keys().hasOnly([
          'bookingId', 'barberId', 'customerUid', 'rating', 'comment', 'customerName', 'customerAvatar', 'createdAt'
        ]);
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role in ['customer', 'barber']
        && request.resource.data.get('loyaltyPoints', 0) == 0
        && request.resource.data.get('totalBookings', 0) == 0
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'phone', 'email', 'avatar', 'role', 'createdAt', 'fcmToken', 'referralCode', 'loyaltyPoints', 'totalBookings'
        ]);
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'phone', 'email', 'avatar', 'fcmToken'
        ]);
      allow delete: if false;
    }

    match /notifications/{nid} {
      allow read: if signedIn() && resource.data.toUid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && notDeleting(request.resource.data.toUid)
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.body is string && request.resource.data.body.size() <= 500
        && request.resource.data.keys().hasOnly([
          'toUid', 'fromUid', 'type', 'title', 'body', 'fromName', 'fromAvatar', 'bookingId', 'postId',
          'read', 'createdAt', 'pushPending', 'nextAttemptAt', 'pushAttempts'
        ])
        && request.resource.data.get('pushPending', true) == true
        && request.resource.data.get('nextAttemptAt', 0) == 0
        && request.resource.data.get('pushAttempts', 0) == 0
        && ((request.resource.data.type == 'booking_request'
            && bookingParticipantAfter(request.resource.data.bookingId)
            && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.customerUid == request.auth.uid
            && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.barberId == request.resource.data.toUid)
          || (request.resource.data.type == 'booking_update'
            && bookingParticipantAfter(request.resource.data.bookingId)
            && request.resource.data.toUid != request.auth.uid
            && request.resource.data.toUid in [
              getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.customerUid,
              getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.barberId
            ]
            && request.auth.uid in [
              getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.customerUid,
              getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.barberId
            ])
          || (request.resource.data.type == 'message'
            && bookingParticipantAfter(request.resource.data.bookingId)
            && request.resource.data.toUid != request.auth.uid
            && request.resource.data.toUid in [
              getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.customerUid,
              getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.barberId
            ])
          || (request.resource.data.type == 'new_post'
            && !exists(/databases/$(database)/documents/accountDeletionPostLocks/$(request.resource.data.postId))
            && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId))
            && get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.ownerUid == request.auth.uid
            && exists(/databases/$(database)/documents/follows/$(request.resource.data.toUid + '__' + request.auth.uid))));
      allow update: if signedIn() && resource.data.toUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
      allow delete: if signedIn() && resource.data.toUid == request.auth.uid;
    }

    match /staff/{staffId} {
      allow read: if signedIn() && (resource.data.salonOwnerId == request.auth.uid || resource.data.barberId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.salonOwnerId == request.auth.uid
        && request.resource.data.barberId == request.auth.uid
        && notDeleting(request.resource.data.salonOwnerId) && notDeleting(request.resource.data.barberId)
        && request.resource.data.keys().hasOnly([
          'barberId', 'salonOwnerId', 'name', 'specialties', 'avatar', 'workingHours',
          'bookingsCount', 'completedCount', 'createdAt'
        ]);
      allow update: if signedIn() && resource.data.salonOwnerId == request.auth.uid
        && notDeleting(resource.data.barberId)
        && request.resource.data.salonOwnerId == resource.data.salonOwnerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'specialties', 'avatar', 'workingHours'
        ]);
      allow delete: if signedIn() && resource.data.salonOwnerId == request.auth.uid;
    }

    match /payouts/{payoutId} {
      allow read: if signedIn() && resource.data.barberId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.barberId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.keys().hasOnly(['barberId', 'amount', 'status', 'method', 'note', 'createdAt']);
      allow update, delete: if false;
    }

    match /checkins/{checkinId} {
      allow read: if signedIn() && (resource.data.customerUid == request.auth.uid || resource.data.barberId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /messages/{bookingId} {
      match /msgs/{subMsgId} {
        allow read: if bookingParticipant(bookingId);
        allow create: if bookingParticipant(bookingId)
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.bookingId == bookingId
          && request.resource.data.toUid in [
            get(/databases/$(database)/documents/bookings/$(bookingId)).data.customerUid,
            get(/databases/$(database)/documents/bookings/$(bookingId)).data.barberId
          ]
          && request.resource.data.toUid != request.auth.uid;
        allow update: if bookingParticipant(bookingId)
          && request.auth.uid == resource.data.toUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && resource.data.read == false && request.resource.data.read == true;
        allow delete: if bookingParticipant(bookingId) && resource.data.fromUid == request.auth.uid;
      }
    }

    match /referrals/{refId} {
      allow read: if signedIn() && (resource.data.inviterUid == request.auth.uid || resource.data.newUserUid == request.auth.uid);
      allow write: if false;
    }

    match /follows/{followId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.followerUid == request.auth.uid
        && notDeleting(request.resource.data.barberId)
        && followId == request.auth.uid + '__' + request.resource.data.barberId
        && exists(/databases/$(database)/documents/barbers/$(request.resource.data.barberId))
        && request.resource.data.keys().hasOnly(['followerUid', 'barberId', 'barberName', 'barberAvatar', 'createdAt']);
      allow delete: if signedIn() && resource.data.followerUid == request.auth.uid;
      allow update: if false;
    }

    match /gallery/{imageId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.barberId == request.auth.uid
        && request.resource.data.keys().hasOnly(['barberId', 'imageUrl', 'thumbnail', 'description', 'createdAt']);
      allow update, delete: if signedIn() && resource.data.barberId == request.auth.uid;
    }
  }
}
